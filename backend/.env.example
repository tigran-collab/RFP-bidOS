# RFP BidOS backend environment variables.
# Copy to backend/.env and fill in real values. Every key below is read by the
# app; unknown extra keys are ignored (Settings uses extra="ignore").

# --- Core ---
# SQLite path is anchored to backend/ when relative (see config.resolve_sqlite_database_url).
DATABASE_URL=sqlite:///./data/rfp_bidos.db

# --- Local AI (Ollama) ---
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:8b

# --- BidNet credentials (Environment-type source credential) ---
BIDNET_USERNAME=
BIDNET_PASSWORD=

# --- Other Environment-type source credentials ---
# For any source whose credential_type is "Environment", the app reads
# {PREFIX}_USERNAME / {PREFIX}_PASSWORD, where PREFIX is the source name
# uppercased with non-alphanumeric chars collapsed to "_"
# (see services/source_credentials._environment_variable_names).
# Examples:
#   PLANETBIDS_USERNAME=
#   PLANETBIDS_PASSWORD=
#   BONFIRE_USERNAME=
#   BONFIRE_PASSWORD=
#
# IMPORTANT: Environment-type source credentials must be REAL process env vars.
# pydantic-settings loads .env into Settings only; it does NOT export .env keys
# to os.environ, and source_credentials reads them via os.getenv(). Set them in
# your shell / service environment (or a tool that exports .env to the process),
# not just in this file.

# --- Browser automation ---
# Playwright browser channel override for headed portal downloads
# (e.g. "chrome", "msedge"). Defaults to bundled Chromium when unset.
RFP_BIDOS_BROWSER_CHANNEL=
